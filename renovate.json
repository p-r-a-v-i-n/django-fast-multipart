{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Asia/Kolkata",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Keep the supported Python floor a deliberate decision",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep the development Python version a deliberate decision",
      "matchManagers": ["pyenv"],
      "enabled": false
    },
    {
      "description": "Group Python build and development tooling",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["build-system.requires", "dependency-groups"],
      "groupName": "Python tooling"
    },
    {
      "description": "Keep Django updates inside the declared supported series",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["django"],
      "rangeStrategy": "in-range-only"
    },
    {
      "description": "Wait briefly before adopting new PyPI releases",
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Include the central uv version with CI tooling updates",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["astral-sh/uv"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Let the digest manager handle the direct Rust dependency",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["rust-multipart"],
      "enabled": false
    },
    {
      "description": "Update every copy of the pinned Rust fork digest together",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "https://github.com/p-r-a-v-i-n/rust-multipart"
      ],
      "groupName": "rust-multipart fork digest"
    },
    {
      "description": "Require approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the rust-multipart feed-eof branch digest",
      "managerFilePatterns": ["/^pyproject\\.toml$/", "/^uv\\.lock$/"],
      "matchStrings": [
        "rust-multipart @ git\\+https://github\\.com/p-r-a-v-i-n/rust-multipart\\.git@(?<currentDigest>[a-f0-9]{40})",
        "rust-multipart\", git = \"https://github\\.com/p-r-a-v-i-n/rust-multipart\\.git\\?rev=(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "feed-eof",
      "depNameTemplate": "rust-multipart fork",
      "packageNameTemplate": "https://github.com/p-r-a-v-i-n/rust-multipart",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Keep both resolved Rust lockfile digests identical",
      "managerFilePatterns": ["/^uv\\.lock$/"],
      "matchStrings": [
        "source = \\{ git = \"https://github\\.com/p-r-a-v-i-n/rust-multipart\\.git\\?rev=(?<currentDigest>[a-f0-9]{40})#[a-f0-9]{40}\" \\}"
      ],
      "autoReplaceStringTemplate": "source = { git = \"https://github.com/p-r-a-v-i-n/rust-multipart.git?rev={{newDigest}}#{{newDigest}}\" }",
      "currentValueTemplate": "feed-eof",
      "depNameTemplate": "rust-multipart fork",
      "packageNameTemplate": "https://github.com/p-r-a-v-i-n/rust-multipart",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track the uv version used by GitHub Actions",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "UV_VERSION: \\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "uv",
      "packageNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
